# SteamOS 3 (Holo / Neptune 6.1-6.5) target built on glibc 2.36 + Linux 6.1 kernel header baseline
# so bundled Qt6 / Python / native probe binaries never require newer glibc than Valve Holo ships.
FROM docker.io/library/debian:bookworm

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential linux-libc-dev linux-headers-amd64 binutils kmod \
    python3 python3-pip python3-venv libpython3.11 default-jdk-headless \
    libglib2.0-0 libgssapi-krb5-2 libegl1 libgl1 libopengl0 libfontconfig1 libdbus-1-3 \
    libsm6 libice6 libxrender1 libxi6 libxtst6 \
    libxkbcommon0 libxkbcommon-x11-0 libxcb-cursor0 libxcb-icccm4 \
    libxcb-image0 libxcb-keysyms1 libxcb-randr0 libxcb-render-util0 \
    libxcb-shape0 libxcb-xinerama0 libxcb-xfixes0 libwayland-client0 libwayland-cursor0 libwayland-egl1 \
    fonts-cantarell ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && python3 -m venv /opt/build-venv \
 && /opt/build-venv/bin/pip install --no-cache-dir --upgrade pip \
 && /opt/build-venv/bin/pip install --no-cache-dir "PySide6-Essentials==6.7.3" "pyinstaller==6.11.1"

ENV PATH="/opt/build-venv/bin:${PATH}"
WORKDIR /src
ENTRYPOINT ["/bin/bash"]
