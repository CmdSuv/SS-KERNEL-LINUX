FROM registry.fedoraproject.org/fedora:43

RUN dnf install -y --setopt=install_weak_deps=False \
    gcc make perl binutils kmod elfutils-libelf-devel openssl \
    kernel-headers kernel-devel java-21-openjdk-headless java-21-openjdk-devel \
    python3 python3-pip python3-pyside6 \
    abattis-cantarell-fonts glib2 krb5-libs mesa-libEGL libglvnd-glx libglvnd-opengl libxkbcommon qt6-qtwayland xcb-util-cursor \
 && for d in /usr/src/kernels/*; do [ -d "$d" ] && k="$(basename "$d")" && mkdir -p "/lib/modules/$k" && ln -sfn "$d" "/lib/modules/$k/build"; done \
 && dnf clean all \
 && python3 -m pip install --no-cache-dir pyinstaller

WORKDIR /src
ENTRYPOINT ["/bin/bash"]
